# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
DB_PATH=data/soc.db
MAX_UPLOAD_MB=10
# Tahun untuk log syslog (auth.log tidak menyimpan tahun). Kosongkan = tahun berjalan.
LOG_YEAR=
# Fitur opsional: penjelasan insiden memakai Local LLM (Ollama)
LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
